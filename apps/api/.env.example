# In production add pool limits so replicas x connection_limit stays under Postgres max_connections:
#   ...?connection_limit=20&pool_timeout=10
DATABASE_URL=postgresql://testwise:testwise@localhost:5433/testwise
PORT=4000
# Generate long random strings for production
JWT_USER_SECRET=change-me-user
JWT_ADMIN_SECRET=change-me-admin
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
PUBLIC_BASE_URL=http://localhost:4000
SEED_ADMIN_EMAIL=admin@testwise.local
SEED_ADMIN_PASSWORD=ChangeMe!2026

# Payments. MOCK works with no keys. Razorpay is selectable in admin only when all three are set.
# Webhook URL to configure in Razorpay: {PUBLIC_BASE_URL}/v1/payments/webhooks/razorpay
# Events: payment_link.paid, payment.failed, refund.processed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: secret for signing simulated MOCK webhooks (derived from JWT_ADMIN_SECRET if unset)
MOCK_WEBHOOK_SECRET=

# Push notifications
# Android (Firebase Cloud Messaging): service account JSON from Firebase console → Project settings → Service accounts.
# Paste the JSON (or base64 of it), or point to the file.
# Firebase project used for Google / phone sign-in (verifies ID tokens; no secret needed) and for push.
FIREBASE_PROJECT_ID=testwisee
# Needed only for push (FCM): Firebase console → Project settings → Service accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=
# iOS (Apple Push Notification service): key from developer.apple.com → Keys (APNs).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=app.testwise.student
APNS_PRODUCTION=false

# Redis: Socket.IO fan-out across instances, rate limits, distributed job locks, caches.
# Railway: add the Redis plugin and reference ${{Redis.REDIS_URL}}.
REDIS_URL=redis://localhost:6379
# Production role split: set true on exactly one duel-engine service; false on API replicas.
# Local development defaults to enabled when unset.
DUELS_ENGINE_ENABLED=
# false on HTTP replicas; true on exactly one dedicated worker (collusion/timing analysis is O(finishers) per attempt)
ANSWER_ANALYSIS_ENABLED=
# Graceful shutdown behind a load balancer: ms to keep serving after /health turns 503 (so it deregisters), and max ms to wait for in-flight requests
SHUTDOWN_DELAY_MS=
SHUTDOWN_TIMEOUT_MS=

# Live proctoring (LiveKit). Local: `docker compose up livekit` (dev key/secret below).
# Production: LiveKit Cloud or a self-hosted LiveKit server. Leave empty to disable live video.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Proctoring evidence (snapshots, audio clips) is stored privately under uploads/private and
# served only to admins with the proctor permission. Max upload size per file in MB.
EVIDENCE_MAX_MB=8

# Device attestation (Admin → Settings → Proctoring). Without these, proctored starts are blocked unless "Require Play Integrity / App Attest" is off.
# Google service account JSON (raw JSON or base64) with the "Play Integrity API" enabled, or a path to the file:
PLAY_INTEGRITY_SA_JSON=
PLAY_INTEGRITY_SA_FILE=
# Salt for hashed device identifiers used by device bans. Set once in production and never change it.
DEVICE_HASH_SALT=change-me
